{
  "name": "@nuxt/fonts",
  "version": "0.14.0",
  "description": "Automatic font configuration for Nuxt apps",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxt/fonts.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/module.mjs",
    "./utils": "./dist/utils.mjs"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/module.d.mts"
      ],
      "utils": [
        "./dist/utils.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build && pnpm client:build",
    "prepack": "pnpm build",
    "client:build": "nuxt generate client",
    "client:dev": "nuxt dev client --port 3300",
    "docs:dev": "cd docs && pnpm dev",
    "docs:build": "cd docs && pnpm build",
    "dev": "nuxt dev playgrounds/basic",
    "dev:nuxt5": "nuxt dev playgrounds/nuxt5",
    "dev:scss": "nuxt dev playgrounds/scss",
    "dev:tailwind": "nuxt dev playgrounds/tailwindcss",
    "dev:unocss": "nuxt dev playgrounds/unocss",
    "dev:build": "nuxt build playgrounds/basic",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare client && nuxt prepare playgrounds/basic && nuxt prepare playgrounds/nuxt5 && nuxt prepare playgrounds/scss && nuxt prepare playgrounds/tailwindcss && nuxt prepare playgrounds/unocss && nuxt prepare docs",
    "release": "echo \"Merge a release PR to main\"",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:types": "vue-tsc --noEmit && pnpm -r test:types",
    "test:watch": "vitest watch"
  },
  "peerDependencies": {
    "subset-font": "^2.9.0"
  },
  "peerDependenciesMeta": {
    "subset-font": {
      "optional": true
    }
  },
  "dependencies": {
    "@nuxt/devtools-kit": "^3.4.2",
    "@nuxt/kit": "^4.6.0",
    "defu": "^6.1.7",
    "exsolve": "^1.1.3",
    "fontless": "^1.2.1",
    "h3": "^1.15.11",
    "magic-regexp": "^0.11.2",
    "nypm": "^0.6.10",
    "ofetch": "^1.5.1",
    "pathe": "^2.0.3",
    "sirv": "^3.0.2",
    "std-env": "^4.3.0",
    "tinyglobby": "^0.2.17",
    "ufo": "^1.6.4",
    "unifont": "^1.0.2",
    "unplugin": "^3.4.0",
    "unstorage": "^1.17.5"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.28",
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/rspack-builder": "^4.6.0",
    "@nuxt/schema": "^4.6.0",
    "@nuxt/test-utils": "^4.3.3",
    "@nuxt/webpack-builder": "^4.6.0",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "birpc": "^4.2.0",
    "consola": "^3.4.2",
    "eslint": "^10.12.0",
    "nitropack": "^2.13.4",
    "nuxt": "^4.6.0",
    "nuxt-fonts-devtools": "workspace:client",
    "pkg-pr-new": "^0.0.91",
    "playwright-core": "^1.64.0",
    "sass": "^1.105.1",
    "sass-loader": "^17.0.1",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vite": "~8.3.4",
    "vitest": "^5.0.3",
    "vue": "3.5.43",
    "vue-bundle-renderer": "^2.4.0",
    "vue-tsc": "^3.3.12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  }
}
